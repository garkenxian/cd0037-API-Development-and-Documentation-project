-- Name: game_sessions game_sessions_category_id_fkey; Type: FK CONSTRAINT; Schema: public; Owner: postgres
--

ALTER TABLE ONLY game_sessions
    ADD CONSTRAINT game_sessions_category_id_fkey FOREIGN KEY (category_id) REFERENCES categories(id);

