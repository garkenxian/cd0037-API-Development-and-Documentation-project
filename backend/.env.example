# Database Configuration
# NOTE: Update these values to match your local PostgreSQL setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trivia
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trivia

# Flask Configuration
FLASK_APP=flaskr
FLASK_ENV=development
FLASK_DEBUG=True

# Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Testing Database (for pytest)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/trivia_test
